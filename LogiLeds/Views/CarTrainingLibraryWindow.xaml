<Window
    x:Class="LogiLeds.Views.CarTrainingLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Car trainings"
    Width="820"
    Height="740"
    MinWidth="660"
    MinHeight="510"
    Background="{DynamicResource WindowBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TrainingProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="4" />
    </shell:WindowChrome.WindowChrome>
    <Border
        Background="{DynamicResource WindowBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:DialogTitleBar
                Title="Car trainings"
                Grid.Row="0"
                ShowMaximizeButton="True" />
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Margin="0,0,0,14"
                    Padding="12,10"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="TrainingIndicator"
                            Width="9"
                            Height="9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource MutedBrush}" />
                        <TextBlock
                            x:Name="TrainingStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MutedBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CurrentVehicleText"
                            Grid.Column="2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Trainings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,8,12"
                                            Padding="16"
                                            CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SurfaceBrush}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource ElevatedBrush}" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding VehicleLabel}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,3"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                            Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="LIVE" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,3,0,12"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    Text="{Binding MappingDetails}" />
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProgressLabel}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{DynamicResource MutedBrush}"
                                                        Text="{Binding ConfidenceLabel}" />
                                                </Grid>
                                                <ProgressBar
                                                    Maximum="100"
                                                    Style="{StaticResource TrainingProgress}"
                                                    Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                <Expander Margin="0,10,0,0">
                                                    <Expander.Style>
                                                        <Style TargetType="Expander">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMapping}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Expander.Style>
                                                    <Expander.Header>
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            Text="{Binding ShiftPointLabel}" />
                                                    </Expander.Header>
                                                    <controls:RpmRangeEditor Margin="0,10,0,0" IsReadOnly="True" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                x:Name="ResetTrainingsButton"
                                Margin="0,4,8,8"
                                HorizontalAlignment="Right"
                                Click="ResetTrainings_OnClick"
                                Content="Reset trainings"
                                Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel
                        x:Name="EmptyState"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="No training data yet" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="Use Smart mode with per-car learning enabled, then upshift at full throttle."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>