<Window
    x:Class="LogiLeds.Views.CarTrainingLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Car trainings"
    Width="820"
    Height="740"
    MinWidth="660"
    MinHeight="510"
    Background="{DynamicResource WindowBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TrainingProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="4" />
    </shell:WindowChrome.WindowChrome>
    <Border
        Background="{DynamicResource WindowBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:DialogTitleBar
                Title="Car trainings"
                Grid.Row="0"
                ShowMaximizeButton="True"
                ShowMinimizeButton="True" />
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="26"
                            FontWeight="Bold"
                            Text="Car trainings" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="Each valid full-throttle upshift adds a sample. Three matching shifts activate learning; more samples can improve confidence." />
                    </StackPanel>
                    <Button
                        x:Name="ResetTrainingsButton"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Click="ResetTrainings_OnClick"
                        Content="Reset trainings"
                        Style="{StaticResource GhostButton}" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,18"
                    Padding="16"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="TrainingIndicator"
                            Width="11"
                            Height="11"
                            Margin="0,0,13,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource MutedBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="Live training status" />
                            <TextBlock
                                x:Name="TrainingStatusText"
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource MutedBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="CurrentVehicleText"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Trainings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,8,14"
                                        Padding="18"
                                        CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="17"
                                                    FontWeight="Bold"
                                                    Text="{Binding VehicleLabel}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="9,4"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="7">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="CURRENT CAR · LIVE" />
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,4,0,15"
                                                FontSize="12"
                                                Foreground="{DynamicResource MutedBrush}"
                                                Text="{Binding MappingDetails}" />
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProgressLabel}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    Text="{Binding ConfidenceLabel}" />
                                            </Grid>
                                            <ProgressBar
                                                Maximum="100"
                                                Style="{StaticResource TrainingProgress}"
                                                Value="{Binding ProgressPercent, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Text="{Binding ShiftPointLabel}" />
                                            <controls:RpmRangeEditor Margin="0,17,0,0" IsReadOnly="True">
                                                <controls:RpmRangeEditor.Style>
                                                    <Style TargetType="controls:RpmRangeEditor">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMapping}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:RpmRangeEditor.Style>
                                            </controls:RpmRangeEditor>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel
                        x:Name="EmptyState"
                        MaxWidth="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="No shift samples yet" />
                        <TextBlock
                            Margin="0,9,0,0"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="Drive in Smart mode with per-car learning enabled. Hold full throttle near the top of a gear, then upshift. The first valid shift appears here."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>