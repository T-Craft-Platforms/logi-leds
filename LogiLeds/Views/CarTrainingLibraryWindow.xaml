<Window
    x:Class="LogiLeds.Views.CarTrainingLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls"
    Title="Car trainings and mappings"
    Width="760"
    Height="720"
    MinWidth="620"
    MinHeight="480"
    Background="{DynamicResource WindowBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Text="Car trainings" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource MutedBrush}"
                    Text="Learned shift points and their generated LED mappings, grouped by vehicle telemetry." />
            </StackPanel>
            <Button
                x:Name="ResetTrainingsButton"
                Grid.Column="1"
                Margin="16,0,0,0"
                Click="ResetTrainings_OnClick"
                Content="Reset trainings"
                Style="{StaticResource GhostButton}" />
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,8,12"
                                Padding="16"
                                Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding VehicleLabel}" />
                                    <TextBlock
                                        Margin="0,3,0,6"
                                        FontSize="12"
                                        Foreground="{DynamicResource MutedBrush}"
                                        Text="{Binding MappingDetails}" />
                                    <controls:RpmRangeEditor
                                        Margin="0,10,0,0"
                                        DataContext="{Binding}"
                                        IsReadOnly="True" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MutedBrush}"
                Text="No car trainings yet. Drive a few full-throttle shifts in Smart mode to build mappings." />
        </Grid>
    </Grid>
</Window>