<UserControl
    x:Class="LogiLeds.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,14,20,20">
        <ScrollViewer Padding="4,20,12,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="Settings" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border
                            Height="210"
                            Margin="0,0,0,16"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,12"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="Appearance" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="Theme" />
                                    <ComboBox
                                        x:Name="ThemeSelector"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{Binding Themes}"
                                        SelectedItem="{Binding Theme}" />
                                    <CheckBox
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0"
                                        Content="Use pointer cursors"
                                        IsChecked="{Binding UsePointerCursors}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border
                            Height="210"
                            Margin="0,0,0,16"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,12"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="Device" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="Wheel" />
                                    <ComboBox
                                        x:Name="WheelSelector"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{Binding WheelOptions}"
                                        SelectedItem="{Binding SelectedWheel}" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,10,0,10"
                                    FontSize="12"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="{Binding WheelVerification}"
                                    TextAlignment="Right" />
                                <Grid
                                    Grid.Row="3"
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="LED test" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding TestCommand}"
                                        Content="Test"
                                        Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,16"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="Startup" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="Close to notification area"
                                    IsChecked="{Binding CloseToTray}" />
                                <CheckBox
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Start App control on launch"
                                    IsChecked="{Binding AutoStartControl}" />
                                <Button
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    Command="{Binding StartStopCommand}"
                                    Content="{Binding StartStopText}"
                                    Style="{StaticResource StartStopButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="Telemetry" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="Choose which game to watch and set up each game below." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinWidth="100"
                                HorizontalAlignment="Right"
                                Click="AddGame_OnClick"
                                Content="Add game"
                                IsEnabled="{Binding CanAddGame}"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <Grid Margin="0,20,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Watch for" />
                            <ComboBox
                                x:Name="WatchSelector"
                                Grid.Column="1"
                                MinWidth="240"
                                ItemsSource="{Binding WatchOptions}"
                                SelectedItem="{Binding SelectedWatch}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <ScrollViewer
                            MaxHeight="232"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TelemetryGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="14,11"
                                            BorderBrush="{DynamicResource MutedBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="{DynamicResource MutedBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    MinWidth="88"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="ManageGame_OnClick"
                                                    Content="Manage"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
