<UserControl
    x:Class="LogiLeds.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsTabsStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel
                                Margin="0,0,0,18"
                                HorizontalAlignment="Left"
                                IsItemsHost="True" />
                            <ScrollViewer
                                Grid.Row="1"
                                Padding="4,0,12,4"
                                VerticalContentAlignment="Top"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ContentPresenter VerticalAlignment="Top" ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,34,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="4,0,0,18"
            FontSize="30"
            FontWeight="Bold"
            Text="Settings" />
        <TabControl Grid.Row="1" Style="{StaticResource SettingsTabsStyle}">
            <TabItem Header="General">
                <StackPanel>
                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,18"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="Appearance" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Theme" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="220"
                                    ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding Theme}" />
                            </Grid>
                            <Border
                                Height="1"
                                Margin="0,18"
                                Background="{DynamicResource BorderBrush}" />
                            <CheckBox Content="Use pointer cursors" IsChecked="{Binding UsePointerCursors}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="App behavior" />
                            <CheckBox Content="Start control on launch" IsChecked="{Binding AutoStartControl}" />
                            <Border
                                Height="1"
                                Margin="0,14"
                                Background="{DynamicResource BorderBrush}" />
                            <CheckBox Content="Close to notification area" IsChecked="{Binding CloseToTray}" />
                            <Border
                                Height="1"
                                Margin="0,14"
                                Background="{DynamicResource BorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Control" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding StartStopCommand}"
                                    Content="{Binding StartStopText}"
                                    Style="{StaticResource StartStopButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem VerticalContentAlignment="Top" Header="Wheel">
                <Border
                    Margin="0,0,0,16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Wheel" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Device" />
                            <ComboBox
                                Grid.Column="1"
                                Width="300"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding WheelOptions}"
                                SelectedItem="{Binding SelectedWheel}" />
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{DynamicResource MutedBrush}"
                            Text="{Binding WheelVerification}" />
                        <Border
                            Height="1"
                            Margin="0,20"
                            Background="{DynamicResource BorderBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="LED test" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding TestCommand}"
                                Content="Test LEDs"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Games">
                <StackPanel>
                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="Active game" />
                            <ComboBox
                                Grid.Column="1"
                                Width="260"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding WatchOptions}"
                                SelectedItem="{Binding SelectedWatch}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,18"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="Game list" />
                            <ItemsControl ItemsSource="{Binding TelemetryGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="16,12"
                                            Background="{DynamicResource ElevatedBrush}"
                                            CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource MutedBrush}"
                                                        Text="{Binding Endpoint}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Click="ConfigureGame_OnClick"
                                                    Content="Configure"
                                                    Style="{StaticResource GhostButton}"
                                                    Tag="{Binding}" />
                                                <CheckBox
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="GameEnabled_OnClick"
                                                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>