<Window
    x:Class="LogiLeds.Views.ProfileNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New RPM profile"
    Width="380"
    Background="{DynamicResource WindowBrush}"
    Foreground="{DynamicResource TextBrush}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                FontSize="19"
                FontWeight="SemiBold"
                Text="Create RPM profile" />
            <TextBlock
                Margin="0,5,0,14"
                Foreground="{DynamicResource MutedBrush}"
                Text="Give the current manual setup a name." />
        </StackPanel>
        <TextBox
            x:Name="NameInput"
            Grid.Row="1"
            MinHeight="38"
            Padding="10,8"
            VerticalContentAlignment="Center"
            MaxLength="48" />
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="2"
            Margin="0,7,0,0"
            Foreground="{DynamicResource DangerBrush}" />
        <StackPanel
            Grid.Row="3"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="82"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True"
                Style="{StaticResource GhostButton}" />
            <Button
                x:Name="CreateButton"
                MinWidth="82"
                Click="Create_OnClick"
                Content="Create"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>