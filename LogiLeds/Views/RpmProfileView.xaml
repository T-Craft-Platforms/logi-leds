<UserControl
    x:Class="LogiLeds.Views.RpmProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls">
    <Grid Margin="20,14,20,20">
        <ScrollViewer Padding="4,20,12,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Text="RPM Profile" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Command="{Binding ResetProfileCommand}"
                            Content="Reset"
                            Style="{StaticResource GhostButton}" />
                        <Button
                            MinHeight="34"
                            Padding="14,7"
                            Command="{Binding SaveCommand}"
                            Content="Apply profile" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border
                            Margin="0,0,0,24"
                            Padding="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource ElevatedBrush}"
                            CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Content="Smart mode"
                                    GroupName="ProfileMode"
                                    IsChecked="{Binding IsEasyMode}"
                                    Style="{StaticResource SegmentStyle}" />
                                <RadioButton
                                    Content="Advanced"
                                    GroupName="ProfileMode"
                                    IsChecked="{Binding IsAdvancedMode}"
                                    Style="{StaticResource SegmentStyle}" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEasyMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="First light" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Text="{Binding FirstLedPercent, StringFormat={}{0:0.0}%}" />
                                        </Grid>
                                        <Slider
                                            Margin="0,8,0,0"
                                            IsSnapToTickEnabled="True"
                                            Maximum="94"
                                            Minimum="50"
                                            TickFrequency="0.5"
                                            Value="{Binding FirstLedPercent}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="Redline" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Text="{Binding RedlinePercent, StringFormat={}{0:0.0}%}" />
                                        </Grid>
                                        <Slider
                                            Margin="0,8,0,0"
                                            IsSnapToTickEnabled="True"
                                            Maximum="100"
                                            Minimum="75"
                                            TickFrequency="0.5"
                                            Value="{Binding RedlinePercent}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <controls:RpmRangeEditor />
                        </Grid>
                        <Border
                            Height="1"
                            Margin="0,24,0,16"
                            Background="{DynamicResource BorderBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Blink at high RPM" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="Flash the complete strip at the redline threshold" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding BlinkAtRedline}" />
                        </Grid>
                        <Border
                            Height="1"
                            Margin="0,24,0,16"
                            Background="{DynamicResource BorderBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Learn per-car shift" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="Adapt the shift point to each car" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                Padding="12,6"
                                Command="{Binding ResetLearningCommand}"
                                Content="Reset learning"
                                Style="{StaticResource GhostButton}" />
                            <CheckBox
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsChecked="{Binding LearnPerCarShift}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>