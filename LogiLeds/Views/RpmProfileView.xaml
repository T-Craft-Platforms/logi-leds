<UserControl
    x:Class="LogiLeds.Views.RpmProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls">
    <Grid Margin="20,14,20,20">
        <ScrollViewer Padding="4,20,12,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Text="RPM Profile" />
                </Grid>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ElevatedBrush}"
                                CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="Smart"
                                        GroupName="ProfileMode"
                                        IsChecked="{Binding IsEasyMode}"
                                        Style="{StaticResource SegmentStyle}" />
                                    <RadioButton
                                        Content="Manual"
                                        GroupName="ProfileMode"
                                        IsChecked="{Binding IsAdvancedMode}"
                                        Style="{StaticResource SegmentStyle}" />
                                </StackPanel>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ComboBox
                                    Width="220"
                                    Margin="0,0,8,0"
                                    ItemsSource="{Binding SavedProfiles}"
                                    SelectedItem="{Binding SelectedSavedProfile}"
                                    TextSearch.TextPath="Name"
                                    ToolTip="Saved profiles for the selected wheel">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Width="88"
                                    MinWidth="0"
                                    Command="{Binding PrimaryProfileCommand}"
                                    Content="{Binding PrimaryProfileActionText}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowLoadProfile}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    x:Name="MoreProfileActionsButton"
                                    Width="72"
                                    MinWidth="0"
                                    Margin="8,0,0,0"
                                    Click="MoreProfileActions_OnClick"
                                    Content="Manage"
                                    Style="{StaticResource GhostButton}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Command="{Binding ResetProfileCommand}" Header="Reset profile" />
                                            <MenuItem Command="{Binding DeleteProfileCommand}" Header="Delete profile" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid controls:TransitionAnimator.Index="0" controls:TransitionAnimator.IsActive="{Binding IsEasyMode}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEasyMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="First light" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Text="{Binding FirstLedPercent, StringFormat={}{0:0.0}%}" />
                                        </Grid>
                                        <Slider
                                            Margin="0,8,0,0"
                                            IsSnapToTickEnabled="True"
                                            Maximum="94"
                                            Minimum="50"
                                            TickFrequency="0.5"
                                            Value="{Binding FirstLedPercent}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="Redline" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Text="{Binding RedlinePercent, StringFormat={}{0:0.0}%}" />
                                        </Grid>
                                        <Slider
                                            Margin="0,8,0,0"
                                            IsSnapToTickEnabled="True"
                                            Maximum="100"
                                            Minimum="75"
                                            TickFrequency="0.5"
                                            Value="{Binding RedlinePercent}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid controls:TransitionAnimator.Index="1" controls:TransitionAnimator.IsActive="{Binding IsAdvancedMode}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <controls:RpmRangeEditor />
                        </Grid>
                        <Border
                            Height="1"
                            Margin="0,24,0,16"
                            Background="{DynamicResource BorderBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Blink at high RPM" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="Flash the complete strip at the redline threshold" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding BlinkAtRedline}" />
                        </Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEasyMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border
                                Height="1"
                                Margin="0,24,0,16"
                                Background="{DynamicResource BorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Learn per-car shift" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource MutedBrush}"
                                        Text="Adapt shift points from full-throttle gear changes" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="OpenCarTrainings_OnClick"
                                    Content="Car trainings"
                                    Style="{StaticResource GhostButton}" />
                                <CheckBox
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding LearnPerCarShift}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>