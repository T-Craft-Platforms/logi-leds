<UserControl
    x:Class="LogiLeds.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,14,20,20">
        <ScrollViewer Padding="4,20,12,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="Dashboard" />
                <Grid Margin="0,0,0,16">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,12"
                                Style="{StaticResource EyebrowStyle}"
                                Text="RPM LIGHTS" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="52"
                                        FontWeight="Bold"
                                        Text="{Binding RpmDisplay}" />
                                    <TextBlock
                                        Margin="10,0,0,10"
                                        VerticalAlignment="Bottom"
                                        FontSize="16"
                                        Foreground="{DynamicResource MutedBrush}"
                                        Text="{Binding MaximumRpmDisplay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{Binding RpmPercentDisplay}" />
                            </Grid>
                            <ItemsControl
                                Grid.Row="2"
                                Margin="0,20,0,18"
                                ItemsSource="{Binding Leds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Height="30"
                                            Margin="4,0"
                                            Background="{Binding Color}"
                                            CornerRadius="8"
                                            Opacity="{Binding Opacity}">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.55"
                                                    ShadowDepth="0"
                                                    Color="{Binding Color.Color}" />
                                            </Border.Effect>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="18"
                        Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="WHEEL" />
                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding WheelName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="18"
                        Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="TELEMETRY" />
                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding TelemetryFormat}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="4"
                        Padding="18"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowStyle}" Text="LED CHECK" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="Run a full sweep" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Padding="14,7"
                                Command="{Binding TestCommand}"
                                Content="Test"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>