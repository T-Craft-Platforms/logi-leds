<UserControl
    x:Class="LogiLeds.Controls.RpmRangeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource MutedBrush}"
                Text="0%" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource MutedBrush}"
                Text="RPM activation timeline" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource MutedBrush}"
                Text="100%" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Thresholds}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse
                                Width="9"
                                Height="9"
                                Margin="0,0,10,0"
                                Fill="{Binding Color}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        </StackPanel>
                        <Slider
                            Grid.Column="1"
                            Margin="16,0"
                            IsSnapToTickEnabled="True"
                            Maximum="99"
                            Minimum="50"
                            TickFrequency="0.5"
                            Value="{Binding Value, Mode=TwoWay}" />
                        <TextBox
                            Grid.Column="2"
                            MinHeight="32"
                            Padding="7,5"
                            HorizontalContentAlignment="Center"
                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                            ToolTip="Enter a percentage" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="82" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Ellipse
                    Width="9"
                    Height="9"
                    Margin="0,0,10,0"
                    Fill="{DynamicResource DangerBrush}" />
                <TextBlock FontWeight="SemiBold" Text="Redline / blink" />
            </StackPanel>
            <Slider
                Grid.Column="1"
                Margin="16,0"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="60"
                TickFrequency="0.5"
                Value="{Binding RedlinePercent, Mode=TwoWay}" />
            <TextBox
                Grid.Column="2"
                MinHeight="32"
                Padding="7,5"
                HorizontalContentAlignment="Center"
                BorderBrush="{DynamicResource DangerBrush}"
                Text="{Binding RedlinePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                ToolTip="Enter a percentage" />
        </Grid>
    </StackPanel>
</UserControl>