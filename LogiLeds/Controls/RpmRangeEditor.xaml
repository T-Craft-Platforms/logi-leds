<UserControl x:Class="LogiLeds.Controls.RpmRangeEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="0%" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            <TextBlock Grid.Column="1" Text="RPM activation timeline" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="100%" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Thresholds}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,10,0"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/></StackPanel>
                        <Slider Grid.Column="1" Minimum="50" Maximum="99" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Value, Mode=TwoWay}" Margin="16,0"/>
                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" HorizontalContentAlignment="Center" Padding="7,5" MinHeight="32" ToolTip="Enter a percentage"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="{DynamicResource DangerBrush}" Margin="0,0,10,0"/><TextBlock Text="Redline / blink" FontWeight="SemiBold"/></StackPanel>
            <Slider Grid.Column="1" Minimum="60" Maximum="100" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RedlinePercent, Mode=TwoWay}" Margin="16,0"/>
            <TextBox Grid.Column="2" Text="{Binding RedlinePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" HorizontalContentAlignment="Center" Padding="7,5" MinHeight="32" BorderBrush="{DynamicResource DangerBrush}" ToolTip="Enter a percentage"/>
        </Grid>
    </StackPanel>
</UserControl>
