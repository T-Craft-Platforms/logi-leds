<UserControl
    x:Class="LogiLeds.Controls.WindowTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiLeds.Controls"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
        MouseRightButtonUp="TitleBar_OnMouseRightButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            Margin="16,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ContentControl
                Width="24"
                Height="24"
                Margin="0,0,10,0"
                Template="{StaticResource BrandMarkTemplate}" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="LogiLeds" />
        </StackPanel>
        <TabControl
            x:Name="TopNavigation"
            Grid.Column="1"
            Height="54"
            HorizontalAlignment="Center"
            Cursor="Arrow"
            ItemContainerStyle="{StaticResource TopNavigationItemStyle}"
            SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
            Style="{StaticResource TopNavigationStyle}">
            <TabItem Header="Dashboard" Style="{StaticResource TopNavigationItemStyle}" />
            <TabItem Header="RPM Profile" Style="{StaticResource TopNavigationItemStyle}" />
            <TabItem Header="Settings" Style="{StaticResource TopNavigationItemStyle}" />
        </TabControl>
        <StackPanel
            Grid.Column="2"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            Orientation="Horizontal">
            <controls:ConnectionStatusPopover Margin="0,0,10,0" />
            <Button
                Click="MinimizeButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Minimize">
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Minus" />
            </Button>
            <Button
                Click="MaximizeButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Maximize or restore">
                <fa:IconImage
                    x:Name="MaximizeIcon"
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Expand" />
            </Button>
            <Button
                Click="CloseButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Close">
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Times" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>