<UserControl
    x:Class="LogiWheelForge.Controls.DialogTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid
        Height="54"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
        MouseRightButtonUp="TitleBar_OnMouseRightButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            Margin="20,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
        <StackPanel
            Grid.Column="2"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            Orientation="Horizontal">
            <Button Click="MinimizeButton_OnClick" ToolTip="Minimize">
                <Button.Style>
                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Minus" />
            </Button>
            <Button
                x:Name="MaximizeButton"
                Click="MaximizeButton_OnClick"
                ToolTip="Maximize">
                <Button.Style>
                    <Style BasedOn="{StaticResource WindowButtonStyle}" TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowMaximizeButton, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <fa:IconImage
                    x:Name="MaximizeIcon"
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Expand" />
            </Button>
            <Button
                Click="CloseButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Close">
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Times" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>