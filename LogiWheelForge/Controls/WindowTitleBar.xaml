<UserControl
    x:Class="LogiWheelForge.Controls.WindowTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiWheelForge.Controls"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
        MouseRightButtonUp="TitleBar_OnMouseRightButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="NavigationToggleButton" Grid.Column="0" Margin="12,0,0,0"
                Click="NavigationToggleButton_OnClick" Style="{StaticResource WindowButtonStyle}"
                ToolTip="Collapse navigation" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <fa:IconImage x:Name="NavigationToggleIcon" Width="14" Height="14"
                          Foreground="{DynamicResource MutedBrush}" Icon="Bars"/>
        </Button>
        <StackPanel x:Name="BrandStack" Grid.Column="1" Margin="12,0,14,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <ContentControl
                Width="24"
                Height="24"
                Margin="0,0,10,0"
                Template="{StaticResource BrandMarkTemplate}" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="LogiWheel Forge" />
        </StackPanel>
        <StackPanel
            Grid.Column="3"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            Orientation="Horizontal">
            <controls:ConnectionStatusPopover Margin="0,0,10,0" />
            <Button
                Click="MinimizeButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Minimize">
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Minus" />
            </Button>
            <Button
                x:Name="MaximizeButton"
                Click="MaximizeButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Maximize">
                <fa:IconImage
                    x:Name="MaximizeIcon"
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Expand" />
            </Button>
            <Button
                Click="CloseButton_OnClick"
                Style="{StaticResource WindowButtonStyle}"
                ToolTip="Close">
                <fa:IconImage
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Icon="Times" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
