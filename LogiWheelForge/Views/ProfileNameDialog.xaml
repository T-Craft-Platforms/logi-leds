<Window
    x:Class="LogiWheelForge.Views.ProfileNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LogiWheelForge.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="New RPM profile"
    Width="380"
    Background="{DynamicResource WindowBrush}"
    Foreground="{DynamicResource TextBrush}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border
        Background="{DynamicResource WindowBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:DialogTitleBar Title="New RPM profile" Grid.Row="0" />
            <Grid Grid.Row="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Text="Create RPM profile" />
                    <TextBlock
                        Margin="0,5,0,14"
                        Foreground="{DynamicResource MutedBrush}"
                        Text="Give the current manual setup a name." />
                </StackPanel>
                <TextBox
                    x:Name="NameInput"
                    Grid.Row="1"
                    MinHeight="38"
                    Padding="10,8"
                    VerticalContentAlignment="Center"
                    MaxLength="48" />
                <TextBlock
                    x:Name="ErrorText"
                    Grid.Row="2"
                    Margin="0,7,0,0"
                    Foreground="{DynamicResource DangerBrush}" />
                <StackPanel
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="82"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource GhostButton}" />
                    <Button
                        x:Name="CreateButton"
                        MinWidth="82"
                        Click="Create_OnClick"
                        Content="Create"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>