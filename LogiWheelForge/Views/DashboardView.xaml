<UserControl
    x:Class="LogiWheelForge.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid Margin="20,14,20,20">
        <ScrollViewer
            Padding="4,4,12,4"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="Dashboard" />
                <WrapPanel Margin="0">
                    <Border
                        Width="230"
                        MinHeight="92"
                        Margin="0,0,12,12"
                        Padding="18"
                        Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="WHEEL" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding WheelName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border
                        Width="230"
                        MinHeight="92"
                        Margin="0,0,12,12"
                        Padding="18"
                        Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="TELEMETRY" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding TelemetryFormat}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource MutedBrush}"
                                Text="{Binding CurrentVehicle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <Border
                    Margin="0,0,0,12"
                    Padding="20"
                    Style="{StaticResource CardStyle}"
                    Visibility="{Binding DataContext.IsLedModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="RPM lights" />
                            <TextBlock
                                Margin="0,4,0,14"
                                Foreground="{DynamicResource MutedBrush}"
                                Text="{Binding ShiftState}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="36"
                                    FontWeight="Bold"
                                    Text="{Binding RpmDisplay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,6"
                                    VerticalAlignment="Bottom"
                                    Foreground="{DynamicResource MutedBrush}"
                                    Text="{Binding MaximumRpmDisplay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{Binding RpmPercentDisplay}" />
                            </Grid>
                            <ItemsControl Margin="-4,16,0,0" ItemsSource="{Binding Leds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Height="24"
                                            Margin="3,0"
                                            Background="{Binding Color}"
                                            CornerRadius="6"
                                            Opacity="{Binding Opacity}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    Margin="0,0,0,12"
                    Padding="20"
                    Style="{StaticResource CardStyle}"
                    Visibility="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Input Mapper" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{DynamicResource MutedBrush}"
                                Text="{Binding MapperStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource MutedBrush}"
                    Text="Both modules are disabled. Enable a module from its page to show it here."
                    Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.IsLedModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                        <Condition Binding="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
