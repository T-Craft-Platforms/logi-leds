<UserControl x:Class="LogiWheelForge.Views.InputMapperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Text="Input Mapper"/>
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" Text="Map wheel controls to the focused app"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ToggleCommand}" Content="{Binding ToggleText}"
                    Style="{StaticResource StartStopButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Profiles"/>
                        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" Text="Each profile can target several executable paths."/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Command="{Binding AddProfileCommand}" Content="New profile" Style="{StaticResource SecondaryButton}"/>
                        <Button Margin="0,6,0,0" Command="{Binding DeleteProfileCommand}" Content="Delete selected" Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="3,7"><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           Text="{Binding ProcessPaths.Count, StringFormat={}{0} target processes}"/></StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,4">
                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="STATUS" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock Margin="0,5,0,0" Text="{Binding Status}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding InputPreview}"/>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedProfile}">
                        <ContentControl.ContentTemplate><DataTemplate>
                            <StackPanel>
                                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Profile"/>
                                            <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Enabled}"/>
                                        </Grid>
                                        <TextBlock Margin="0,14,0,5" Text="Name"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Margin="0,16,0,5" FontWeight="SemiBold" Text="Target processes"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                   Text="Mapping runs only while one of these executables owns the foreground window."/>
                                        <ListBox Margin="0,8,0,6" MaxHeight="100" ItemsSource="{Binding ProcessPaths}"
                                                 SelectedItem="{Binding DataContext.SelectedProcessPath, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DataContext.ManualProcessPath, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Full path to an executable"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Content="Add path"
                                                    Command="{Binding DataContext.AddProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource SecondaryButton}"/>
                                            <Button Grid.Column="2" Margin="6,0,0,0" Content="Pick window"
                                                    Command="{Binding DataContext.PickWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource SecondaryButton}"/>
                                        </Grid>
                                        <Button Margin="0,7,0,0" HorizontalAlignment="Left" Content="Remove selected path"
                                                Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource GhostButton}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Mapping rules"/>
                                            <Button Grid.Column="1" Content="Add rule" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Button Grid.Column="2" Margin="6,0,0,0" Content="Remove" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Grid>
                                        <ListBox Margin="0,12,0,10" MaxHeight="145" ItemsSource="{Binding Rules}"
                                                 DisplayMemberPath="Summary"
                                                 SelectedItem="{Binding DataContext.SelectedRule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                                        <ContentControl Content="{Binding DataContext.SelectedRule, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ContentControl.ContentTemplate><DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Input control"/><ComboBox IsEditable="True" Text="{Binding Control, UpdateSourceTrigger=LostFocus}"
                                                            ItemsSource="{Binding DataContext.Controls, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Trigger"/><ComboBox SelectedItem="{Binding Trigger}"
                                                            ItemsSource="{Binding DataContext.Triggers, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Step behavior"/><ComboBox SelectedItem="{Binding StepMode}"
                                                            ItemsSource="{Binding DataContext.StepModes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Direction (-1 left, 1 right)"/>
                                                        <ComboBox SelectedItem="{Binding Direction}" ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Step size %"/><TextBox Text="{Binding StepPercent}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Range min / max %"/>
                                                        <StackPanel Orientation="Horizontal"><TextBox Width="74" Text="{Binding MinPercent}"/>
                                                            <TextBox Width="74" Margin="6,0,0,0" Text="{Binding MaxPercent}"/></StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Action"/><ComboBox SelectedItem="{Binding Action}"
                                                            ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Mode"/><ComboBox SelectedItem="{Binding Mode}"
                                                            ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Key / mouse button / axis"/><TextBox Text="{Binding Output}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Tap duration (ms)"/><TextBox Text="{Binding DurationMs}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Output scale"/><TextBox Text="{Binding OutputScale}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Hold strength %"/><TextBox Text="{Binding ForceStrength}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Hold target %"/><TextBox Text="{Binding TargetPercent}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Hold release"/><ComboBox SelectedItem="{Binding ForceRelease}"
                                                            ItemsSource="{Binding DataContext.ForceReleases, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <TextBlock Margin="0,9,0,0" Text="Dead zone / hysteresis %"/>
                                                        <StackPanel Orientation="Horizontal"><TextBox Width="74" Text="{Binding DeadZonePercent}"/>
                                                            <TextBox Width="74" Margin="6,0,0,0" Text="{Binding HysteresisPercent}"/></StackPanel>
                                                        <TextBlock Margin="0,9,0,0" Text="Axis curve exponent"/><TextBox Text="{Binding CurveExponent}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate></ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Resistance"/>
                                        <CheckBox Margin="0,12,0,4" Content="Enable resistance for this profile" IsChecked="{Binding ResistanceEnabled}"/>
                                        <TextBlock Text="Center strength"/><Slider Minimum="0" Maximum="100" Value="{Binding CenterStrength}"/>
                                        <TextBlock Text="Damping strength"/><Slider Minimum="0" Maximum="100" Value="{Binding DampingStrength}"/>
                                        <CheckBox Margin="0,10,0,5" Content="Soft detents" IsChecked="{Binding DetentsEnabled}"/>
                                        <TextBlock Text="Detent spacing %"/><TextBox Text="{Binding DetentSpacingPercent}"/>
                                        <TextBlock Margin="0,8,0,0" Text="Detent strength"/><Slider Minimum="0" Maximum="100" Value="{Binding DetentStrength}"/>
                                    </StackPanel>
                                </Border>
                                <Button HorizontalAlignment="Right" Content="Save profiles" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </DataTemplate></ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
