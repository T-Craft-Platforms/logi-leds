<UserControl x:Class="LogiWheelForge.Views.InputMapperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LogiWheelForge.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MapperControls.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="4,4,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding PageTitle}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Turn wheel controls into keyboard and mouse actions." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="MODULE" FontSize="11" />
                <ToggleButton Style="{DynamicResource ModuleToggleStyle}"
                              IsChecked="{Binding DataContext.IsInputMapperModuleEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              AutomationProperties.Name="Input Mapper module" ToolTip="Enable or disable Input Mapper" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,6,8,14">
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="YOUR PROFILES" />
                        <Button Margin="0,12,0,0" Content="+ New profile" Command="{Binding AddProfileCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Content="Delete profile" Command="{Binding DeleteProfileCommand}" Style="{StaticResource GhostButton}" />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutomationProperties.Name="Mapping profiles">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="{Binding Rules.Count, StringFormat={}{0} mappings}" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Border VerticalAlignment="Top" Padding="28">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Make your wheel work your way" />
                        <TextBlock Margin="0,10,0,20" Foreground="{DynamicResource MutedBrush}" Text="Create a profile, choose its application, then assign actions to your controls." />
                        <Button HorizontalAlignment="Left" Content="Create a profile" Command="{Binding AddProfileCommand}" />
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding SelectedProfile}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTemplate><DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="2,0,8,14">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="{Binding ProcessPaths.Count, StringFormat={}{0} linked applications}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Margin="12,0,0,0" Content="Enabled" IsChecked="{Binding Enabled}" />
                            </Grid>
                            <TabControl Grid.Row="1" SelectedIndex="{Binding DataContext.EditorTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                                <TabItem Header="Mappings">
                                    <StackPanel>
                                        <Grid Margin="2,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,0"
                                                       Text="{Binding DataContext.InputPreview, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button Grid.Column="1" Content="+ Add mapping" Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButton}" />
                                        </Grid>
                                        <ComboBox MinHeight="64" ItemsSource="{Binding Rules}" SelectedItem="{Binding DataContext.SelectedRule, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                 AutomationProperties.Name="Mapping rules">
                                            <ComboBox.ItemTemplate><DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="{Binding Control}" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="{Binding TriggerLabel}" /></StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Text="→" FontSize="18" />
                                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding ActionLabel}" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="{Binding OutputSummary}" /></StackPanel>
                                                </Grid>
                                            </DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Margin="12" Foreground="{DynamicResource MutedBrush}" Text="No mappings yet. Add one to choose a wheel control and its action.">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Rules.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <ContentControl Margin="0,8,0,0" Content="{Binding DataContext.SelectedRule, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ContentControl.ContentTemplate><DataTemplate><controls:MapperRuleEditor /></DataTemplate></ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="Delete mapping" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Applications">
                                    <Border Style="{StaticResource CardStyle}" Padding="20">
                                        <StackPanel>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Profile setup" />
                                            <TextBlock Style="{StaticResource MapperLabel}" Text="Profile name" />
                                            <TextBox MaxLength="64" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,22,0,6" FontSize="16" FontWeight="SemiBold" Text="Linked applications" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Mappings activate when a linked application is in the foreground." />
                                            <Button Margin="0,16,0,12" HorizontalAlignment="Left" Content="Pick an open window" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.PickWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <ListBox MaxHeight="180" ItemsSource="{Binding ProcessPaths}" SelectedItem="{Binding DataContext.SelectedProcessPath, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" AutomationProperties.Name="Linked applications">
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding}" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Margin="0,8" Foreground="{DynamicResource WarningBrush}" FontSize="12" Text="Link an application to activate this profile.">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ProcessPaths.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Button HorizontalAlignment="Left" Content="Remove selected application" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Expander Margin="0,14,0,0" Header="Add an executable path manually">
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Style="{StaticResource MapperLabel}" Text="Full path to an .exe file" />
                                                    <TextBox Text="{Binding DataContext.ManualProcessPath, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Add application" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.AddProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Resistance">
                                    <Border Style="{StaticResource CardStyle}" Padding="20">
                                        <StackPanel>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Wheel feel" />
                                            <TextBlock Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Tune centering and damping for this profile." />
                                            <CheckBox Content="Enable resistance" IsChecked="{Binding ResistanceEnabled}" />
                                            <StackPanel IsEnabled="{Binding ResistanceEnabled}" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding CenterStrength, StringFormat=Center strength · {0:0}%}" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding CenterStrength}" />
                                                <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding DampingStrength, StringFormat=Damping strength · {0:0}%}" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding DampingStrength}" />
                                                <CheckBox Margin="0,20,0,8" Content="Soft detents" IsChecked="{Binding DetentsEnabled}" />
                                                <StackPanel Visibility="{Binding DetentsEnabled, Converter={StaticResource ShowWhenTrue}}">
                                                    <TextBlock Style="{StaticResource MapperLabel}" Text="Detent spacing (%)" /><TextBox Text="{Binding DetentSpacingPercent, ValidatesOnExceptions=True}" />
                                                    <TextBlock Style="{StaticResource MapperLabel}" Text="{Binding DetentStrength, StringFormat=Detent strength · {0:0}%}" />
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding DetentStrength}" />
                                                    <Expander Margin="0,12,0,0" Header="Detent fine tuning">
                                                        <StackPanel><TextBlock Style="{StaticResource MapperLabel}" Text="Detent hysteresis (%)" /><TextBox Text="{Binding DetentHysteresisPercent, ValidatesOnExceptions=True}" /></StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DataTemplate></ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="4,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Status}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="{Binding EditStatus}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Save changes" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
