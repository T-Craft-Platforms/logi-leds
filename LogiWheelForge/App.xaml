<Application
    x:Class="LogiWheelForge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Cursor x:Key="InteractiveCursor">Hand</Cursor>
            <SolidColorBrush x:Key="BrandWheelBrush" Color="#47C9FF" />
            <ControlTemplate x:Key="WheelGlyphTemplate" TargetType="ContentControl">
                <Viewbox Stretch="Uniform">
                    <Grid Width="24" Height="24">
                        <Ellipse
                            Margin="2.5"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="2" />
                        <Path
                            Data="M 12,12 L 12,4 M 12,12 L 5.2,17 M 12,12 L 18.8,17"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource ElevatedBrush}"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="1.5" />
                    </Grid>
                </Viewbox>
            </ControlTemplate>
            <ControlTemplate x:Key="BrandMarkTemplate" TargetType="ContentControl">
                <Viewbox Stretch="Uniform">
                    <Grid Width="100" Height="100">
                        <Border Background="#0B1422" CornerRadius="26" />
                        <Ellipse
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{StaticResource BrandWheelBrush}"
                            StrokeThickness="9" />
                        <Path
                            Data="M 50,50 L 50,24 M 50,50 L 28,67 M 50,50 L 72,67"
                            Fill="Transparent"
                            Stroke="{StaticResource BrandWheelBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />
                        <Ellipse
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#0B1422"
                            Stroke="#D7F8FF"
                            StrokeThickness="3" />
                    </Grid>
                </Viewbox>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>